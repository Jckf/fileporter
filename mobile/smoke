#
# Opens the app on a fresh emulator (optionally on a link) and saves a
# screenshot and the app's log. Run it after mobile/build android:
#
#   FP_IMAGE=emulator mobile/run mobile/smoke [link]
#
# With a link (https://fileporter.app/#R…), the app is opened on it,
# as tapping a shared link would.
set -eu
[ -n "${FP_EMULATOR_UP:-}" ] || FP_EMULATOR_UP=1 exec "$(dirname "$0")/emulator" "$0" "$@"

out=${FP_OUT:-mobile/smoke-out}
link=${1:-}
adb logcat -c
if [ -n "$link" ]; then
  adb shell am start -W -a android.intent.action.VIEW -d "'$link'" app.fileporter >/dev/null
else
  adb shell am start -W -n app.fileporter/.MainActivity >/dev/null
fi
# Give the engine (6 MB of WebAssembly) time to load.
sleep "${FP_SETTLE:-20}"
adb exec-out screencap -p >"$out/screen.png"
adb logcat -d -s Capacitor:* Capacitor/Console:* chromium:* >"$out/logcat.txt" || true
echo "screenshot: $out/screen.png"
