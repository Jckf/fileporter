<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- fileporter links open the app (Universal Links), verified
	     against /.well-known/apple-app-site-association on the site. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:fileporter.app</string>
	</array>
</dict>
</plist>
