# Builds the apps. Run it in the build container: mobile/run mobile/build <step…>
#
#   sync     build the site into mobile/www and copy it into the native projects
#   android  sync, then build a debug APK (mobile/android/app/build/outputs/apk/debug/)
#
# The site is the same as fileporter.app's (cmd/build); the app bundles
# it, so it starts offline and each release ships a fixed version.
set -eu
cd "$(dirname "$0")"
sync() {
  (cd .. && go run ./cmd/build -o mobile/www)
  # Reinstall when the lockfile changed since the last install.
  [ node_modules/.package-lock.json -nt package-lock.json ] || npm ci --no-audit --no-fund
  npx cap sync
}
for step in "${@:-android}"; do
  case $step in
    sync) sync ;;
    android) sync; (cd android && ./gradlew --no-daemon -q assembleDebug) ;;
    *) echo "unknown step: $step" >&2; exit 2 ;;
  esac
done
