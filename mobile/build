#!/bin/sh
# Copyright (c) 2026 Jim C K Flaten
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Builds the apps. Run it in the build container: mobile/run mobile/build <step…>
#
#   sync     build the site into mobile/www and copy it into the native projects
#   android  sync, then build a debug APK (mobile/android/app/build/outputs/apk/debug/)
#   assets   regenerate the app icons and launch screens in the native
#            projects from assets/*.svg (commit the result)
#
# The site is the same as fileporter.app's (cmd/build); the app bundles
# it, so it starts offline and each release ships a fixed version.
set -eu
cd "$(dirname "$0")"
sync() {
  (cd .. && go run ./cmd/build -o mobile/www)
  # Reinstall when the lockfile changed since the last install.
  [ node_modules/.package-lock.json -nt package-lock.json ] || npm ci --no-audit --no-fund
  npx cap sync
}
assets() {
  # @capacitor/assets wants PNGs; the icon is the site's maskable one.
  rsvg-convert -w 1024 -h 1024 ../web/icons/icon-maskable.svg -o assets/icon-only.png
  rsvg-convert -w 1024 -h 1024 assets/icon-foreground.svg -o assets/icon-foreground.png
  rsvg-convert -w 1024 -h 1024 assets/icon-background.svg -o assets/icon-background.png
  rsvg-convert -w 2732 -h 2732 assets/splash.svg -o assets/splash.png
  cp assets/splash.png assets/splash-dark.png
  green='#0b7a69'
  npx capacitor-assets generate --android --ios \
    --iconBackgroundColor "$green" --iconBackgroundColorDark "$green" \
    --splashBackgroundColor "$green" --splashBackgroundColorDark "$green"
}
for step in "${@:-android}"; do
  case $step in
    sync) sync ;;
    assets) [ node_modules/.package-lock.json -nt package-lock.json ] || npm ci --no-audit --no-fund; assets ;;
    android) sync; (cd android && ./gradlew --no-daemon -q assembleDebug) ;;
    *) echo "unknown step: $step" >&2; exit 2 ;;
  esac
done
